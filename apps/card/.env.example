# Copy to .env.local for development. In production, set these on the Vercel
# project. Values come from the Neon project "mohdaslam-card".

# Postgres (pooled connection string from Neon > Connect).
DATABASE_URL=

# Managed Better Auth: Neon > Auth > Configuration.
NEON_AUTH_BASE_URL=
# 32+ random characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage: the branch's S3 endpoint and a storage:read+write
# credential (Neon > Settings > Credentials).
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_BUCKET=card-media

# Salt for hashing contact-form senders (rate limiting). Any random string.
LEAD_HASH_SALT=

# Public origin of this app, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://card.mohdaslam.dev

# Optional: email the card owner when someone sends the contact form.
# Without these, submissions are still stored and shown in the inbox.
RESEND_API_KEY=
RESEND_FROM=
