# Copy to .env.local and fill in. Never commit .env.local.
# The emcee site needs no secrets — it is static content with no forms,
# no email and no third-party services.

# ===========================================================================
# SITE URL
# ===========================================================================
# Canonical origin for metadata and the sitemap. Must match the host Vercel
# actually serves for this project.
#
# On preview deployments set this to the preview origin so previews do not
# claim to be production.
NEXT_PUBLIC_SITE_URL=https://emcee.mohdaslam.dev

# The portfolio this site links back to, once, in the footer.
NEXT_PUBLIC_PORTFOLIO_URL=https://mohdaslam.dev
