# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/

# next.js — build output lives inside each app
.next/
out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# Private content: unpublished verification notes, permission records and any
# item whose visibility is not public. Never committed, never imported by app
# code, never present in a build. See PRD s13.1.
apps/*/content/private/

# test output
/coverage/

# typescript
*.tsbuildinfo
next-env.d.ts
# graphify knowledge graph — generated locally, rebuilt by `graphify update .`
graphify-out/

# Claude Code hooks point at machine-specific paths
.claude/settings.json
