# Copy to .env.local and fill in. Never commit .env.local.
# All of these are server-side only — none are exposed to the browser.

# ---------------------------------------------------------------------------
# Contact form delivery (Brevo)
# ---------------------------------------------------------------------------
# Without these the form still renders and validates, but returns an honest
# "not connected yet" message instead of pretending to send. Nothing breaks.
#
# Get a key at https://app.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=

# Must be a sender address verified in your Brevo account. This is the From
# address; the visitor's address goes in Reply-To, so replies reach them.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="mohdaslam.dev"

# Where enquiries are delivered.
CONTACT_RECIPIENT_EMAIL=

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# Canonical origin, used for metadata, sitemap and Open Graph URLs. Leave unset
# in production to use the default (https://mohdaslam.dev). On Vercel preview
# deployments set this to the preview origin so canonicals are not wrong.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
