# Copy to .env.local and fill in. Never commit .env.local.
# All server-side only — none of these except NEXT_PUBLIC_* reach the browser.

# ===========================================================================
# CONTACT FORM (Brevo) — all three REQUIRED, or the form reports itself
# unavailable and logs which one is missing.
# ===========================================================================

# 1. API key. https://app.brevo.com -> SMTP & API -> API Keys
#    Without this nothing sends, regardless of the other two.
BREVO_API_KEY=

# 2. The From address. Must be a sender you have VERIFIED in Brevo, otherwise
#    Brevo rejects the send with 400 invalid_parameter.
#    Replies go to the visitor via Reply-To, not to this address.
BREVO_SENDER_EMAIL=

# 3. Where enquiries are delivered. SUPPORT_EMAIL is accepted as an alias if
#    you already use that name.
CONTACT_RECIPIENT_EMAIL=

# Optional. Falls back to APP_NAME, then to "Portfolio".
BREVO_SENDER_NAME=

# ===========================================================================
# SITE URL
# ===========================================================================
# Canonical origin for metadata, sitemap, Open Graph and the email logo.
#
# IMPORTANT: this must match the host Vercel actually serves. If Vercel's
# primary domain is www but this says the apex, every canonical points at a
# URL that 308-redirects. Set the primary domain and this value to the same
# host.
#
# On preview deployments set this to the preview origin so previews do not
# claim to be production.
NEXT_PUBLIC_SITE_URL=https://mohdaslam.dev

# ===========================================================================
# OPTIONAL
# ===========================================================================
# Used as the email sender name if BREVO_SENDER_NAME is unset.
APP_NAME=
