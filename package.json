{
  "name": "mohdaslam-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run typecheck",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "validate:content": "jest --testPathPatterns=content",
    "check:leaks": "node scripts/check-leaks.mjs",
    "refresh:screenshots": "node --conditions=react-server -r tsx/cjs scripts/refresh-project-screenshots.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:leaks"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.4",
