    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "15.2.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.62.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
